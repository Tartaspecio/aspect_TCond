# This is a cookbook of modeling a thermochemical plumes using the  multicomponent
# Steinberger material model. The model setup is similar to Dannberg and Sobolev (2015).

set Output directory                       = output-multicomponent-steinberger
set CFL number                             = 1.0
set End time                               = 1e9
set Adiabatic surface temperature          = 1600.0
set Use years in output instead of seconds = true
set Maximum first time step                = 1.e4
set Resume computation                     = false

# Multiple composition setup
subsection Compositional fields
  set Number of fields = 6
  set Names of fields  = basalt_fraction, bgm090mg_fraction, bgm097mg_fraction, \
                         bgm100mg_fraction, bgm_al_mg_fraction, bgm_fe_al_fraction
  set Types of fields  = chemical composition, chemical composition, chemical composition, \
                         chemical composition, chemical composition, chemical composition
end

# Prescribe the initial composition.
# The setup is similar to Supplementary Figure 2b (Dannberg and Sobolev, 2015)
# Geometry and composition constants are defined in
# steinberger_thermochemical_plume_cartesian_rectangular_parameters.prm.
subsection Initial composition model
  set List of model names = function

  subsection Function
    set Coordinate system   = cartesian
    set Variable names      = x, y
    # The parent rectangle reaches the bottom at y=0. Its x-width is set by
    # parent_width; subregion bounds are independently editable.
    # Subregions are inactive by default; set subregion_count and their bounds
    # in the included parameters file to enable them.
    include $ASPECT_SOURCE_DIR/cookbooks/multicomponent_steinberger/steinberger_thermochemical_plume_cartesian_rectangular_parameters.prm
    set Function expression = ((x >= parent_x_min && x <= parent_x_min+parent_width && \
                                y >= 0 && y <= parent_height) ? \
                                 (((subregion_count >= 1 && \
                                    x >= subregion_1_x_min && x <= subregion_1_x_max && \
                                    y >= subregion_1_y_min && y <= subregion_1_y_max) || \
                                   (subregion_count >= 2 && \
                                    x >= subregion_2_x_min && x <= subregion_2_x_max && \
                                    y >= subregion_2_y_min && y <= subregion_2_y_max) || \
                                   (subregion_count >= 3 && \
                                    x >= subregion_3_x_min && x <= subregion_3_x_max && \
                                    y >= subregion_3_y_min && y <= subregion_3_y_max) || \
                                   (subregion_count >= 4 && \
                                    x >= subregion_4_x_min && x <= subregion_4_x_max && \
                                    y >= subregion_4_y_min && y <= subregion_4_y_max)) ? \
                                  basalt_fraction_subregion : basalt_fraction_main) : 0); \
                               ((x >= parent_x_min && x <= parent_x_min+parent_width && \
                                 y >= 0 && y <= parent_height) ? \
                                 (((subregion_count >= 1 && \
                                    x >= subregion_1_x_min && x <= subregion_1_x_max && \
                                    y >= subregion_1_y_min && y <= subregion_1_y_max) || \
                                   (subregion_count >= 2 && \
                                    x >= subregion_2_x_min && x <= subregion_2_x_max && \
                                    y >= subregion_2_y_min && y <= subregion_2_y_max) || \
                                   (subregion_count >= 3 && \
                                    x >= subregion_3_x_min && x <= subregion_3_x_max && \
                                    y >= subregion_3_y_min && y <= subregion_3_y_max) || \
                                   (subregion_count >= 4 && \
                                    x >= subregion_4_x_min && x <= subregion_4_x_max && \
                                    y >= subregion_4_y_min && y <= subregion_4_y_max)) ? \
                                  bgm090mg_fraction_subregion : bgm090mg_fraction_main) : 0); 0; 0; 0; 0
  end
end

# The Material model setup is similar to "steinberger.prm" except we have
# N+1 material file for N compositional fields. The material files are ordered as
# "background, field#1, field#2, ..."
subsection Material model
  set Model name = Steinberger

  subsection Steinberger model
    set Data directory                   = $ASPECT_SOURCE_DIR/data/material-model/steinberger/
    # The lookup formulation requires the standard Perple_X columns plus
    # k,W/m/K in every table. The available *_k file for this slot contains
    # MORB lookup data, so its full set of material properties is used here.
    set Material file names              = pyr_MS95_with_volume_fractions_lo_res_k.dat, \
          morb_G13_with_volume_fractions_lo_res_k.dat, \
          pyr_Bgm090Mg_with_volume_fractions_lo_res_k.dat, \
          pyr_Bgm097Mg_with_volume_fractions_lo_res_k.dat, \
          pyr_Bgm100Mg_with_volume_fractions_lo_res_k.dat, \
          pyr_BgmAl_Mg_with_volume_fractions_lo_res_k.dat, \
          pyr_BgmFe_Al_with_volume_fractions_lo_res_k.dat
    set Lateral viscosity file name      = temp-viscosity-prefactor.txt
    set Radial viscosity file name       = radial-visc-simple.txt
    set Bilinear interpolation           = true
    set Latent heat                      = false

    # Read k,W/m/K from both material tables and use a geometric volume average.
    set Thermal conductivity formulation = lookup

    # You must set this to false to avoid step-wise viscosity inherited
    # from the reference profile "radial-visc-simple.txt".
    set Use lateral average temperature for viscosity = false
  end
end

# Prescribe the initial temperature.
# Here we are using half-space cooling model to set up a 50 Ma top boundary
# layer and a 700 Ma bottom boundary layer. The setup of the plume excess
# temperature is similar to Supplementary Figure 2a (Dannberg and Sobolev, 2015)
# and is described by the function. All the expressions in the boundary
# temperature model and the function are added to the adiabatic temperature
# profile because we set the model operators as "add". You can also use
# "subtract, minimum, maximum, replace if valid".

# The constants used in the function:
#  Tex = plume excess temperature
#  Tb = bottom temperature
#  Tab = the adiabatic bottom temperature, should be consistent with the
#       adiabatic surfacetemperature of the model.
#  age = must be consistent with the "Age bottom boundary layer" in seconds
#  kappa = should be consistent with the characteristic Cp, rho, and k around
#        the CMB
subsection Initial temperature model
  set List of model operators = add
  set List of model names = adiabatic, function

  subsection Adiabatic
    set Age top boundary layer = 5e7
    set Age bottom boundary layer = 7e8

    subsection Function
      include $ASPECT_SOURCE_DIR/cookbooks/multicomponent_steinberger/steinberger_thermochemical_plume_cartesian_rectangular_parameters.prm
      set Variable names      = x, y

      # Keep these composition expressions consistent with the initial composition model.
      set Function expression = ((x >= parent_x_min && x <= parent_x_min+parent_width && \
                                  y >= 0 && y <= parent_height) ? \
                                   (((subregion_count >= 1 && \
                                      x >= subregion_1_x_min && x <= subregion_1_x_max && \
                                      y >= subregion_1_y_min && y <= subregion_1_y_max) || \
                                     (subregion_count >= 2 && \
                                      x >= subregion_2_x_min && x <= subregion_2_x_max && \
                                      y >= subregion_2_y_min && y <= subregion_2_y_max) || \
                                     (subregion_count >= 3 && \
                                      x >= subregion_3_x_min && x <= subregion_3_x_max && \
                                      y >= subregion_3_y_min && y <= subregion_3_y_max) || \
                                     (subregion_count >= 4 && \
                                      x >= subregion_4_x_min && x <= subregion_4_x_max && \
                                      y >= subregion_4_y_min && y <= subregion_4_y_max)) ? \
                                    basalt_fraction_subregion : basalt_fraction_main) : 0); \
                                 ((x >= parent_x_min && x <= parent_x_min+parent_width && \
                                   y >= 0 && y <= parent_height) ? \
                                   (((subregion_count >= 1 && \
                                      x >= subregion_1_x_min && x <= subregion_1_x_max && \
                                      y >= subregion_1_y_min && y <= subregion_1_y_max) || \
                                     (subregion_count >= 2 && \
                                      x >= subregion_2_x_min && x <= subregion_2_x_max && \
                                      y >= subregion_2_y_min && y <= subregion_2_y_max) || \
                                     (subregion_count >= 3 && \
                                      x >= subregion_3_x_min && x <= subregion_3_x_max && \
                                      y >= subregion_3_y_min && y <= subregion_3_y_max) || \
                                     (subregion_count >= 4 && \
                                      x >= subregion_4_x_min && x <= subregion_4_x_max && \
                                      y >= subregion_4_y_min && y <= subregion_4_y_max)) ? \
                                    bgm090mg_fraction_subregion : bgm090mg_fraction_main) : 0); 0; 0; 0; 0
    end
  end

  subsection Function
    set Coordinate system   = cartesian
    set Variable names      = x, y
    # Apply the same rectangular footprint as the initial composition anomaly.
    include $ASPECT_SOURCE_DIR/cookbooks/multicomponent_steinberger/steinberger_thermochemical_plume_cartesian_rectangular_parameters.prm
    set Function expression = ((x >= parent_x_min && x <= parent_x_min+parent_width && \
                                y >= 0 && y <= parent_height) ? \
                               temperature_excess : 0)
  end
end

subsection Boundary temperature model
  set List of model names = box
  set Fixed temperature boundary indicators   = bottom, top

  subsection Box
    set Bottom temperature = 3550
    set Top temperature = 288
  end
end

# generate visualization and statistic files.
subsection Postprocess
  set List of postprocessors = visualization, velocity statistics, basic statistics, temperature statistics, heat flux statistics, depth average

  subsection Visualization
    set Interpolate output            = false
    set Output format                 = vtu
    set List of output variables      = depth, material properties, named additional outputs
    set Time between graphical output = 5e6

    subsection Material properties
      set List of material properties   = viscosity, density, specific heat, thermal conductivity, thermal expansivity, compressibility
    end
  end
end

# other model setup
subsection Geometry model
  set Model name = box

  subsection Box
    set X extent = 10000e3
    set Y extent = 2890e3
  end
end

# Free slip on all boundaries.
subsection Boundary velocity model
  set Tangential velocity boundary indicators = top, bottom, left, right
end

subsection Gravity model
  set Model name = vertical

  subsection Vertical
    set Magnitude = 9.81
  end
end

subsection Heating model
  set List of model names = adiabatic heating
end

subsection Mesh refinement
  set Initial adaptive refinement        = 1
  set Initial global refinement          = 7
  set Refinement fraction                = 0.3
  set Coarsening fraction                = 0.0
  set Strategy                           = temperature
  set Time steps between mesh refinement = 1
end

subsection Checkpointing
  set Time between checkpoint = 3600
end